# Backend configuration (not secrets). Supply values after choosing an authorized account.
ATLAS_PROJECT_ID=
ATLAS_LOCATION=
# Choose a supported Gemini model in the selected Vertex AI location; no fallback provider.
ATLAS_MODEL=
ATLAS_GCS_BUCKET=
ATLAS_FIRESTORE_DATABASE=(default)
ATLAS_FIRESTORE_PREFIX=atlas

# Local defaults; production receives the same values through Cloud Run configuration.
ATLAS_MAX_MODEL_CALLS=12
ATLAS_MAX_OUTPUT_TOKENS=4096
ATLAS_MAX_RETRIES=1
ATLAS_MAX_REVISION_ROUNDS=1
ATLAS_REQUEST_TIMEOUT_SECONDS=120
ATLAS_MAX_CONCURRENCY=1
ATLAS_MAX_EVAL_CASES=3
ATLAS_MAX_UPLOAD_BYTES=20971520
ATLAS_MAX_PDF_PAGES=100
ATLAS_FRONTEND_DIST=../frontend/dist

# Credentials are NOT configured here. Prefer:
#   gcloud auth application-default login
# Cloud Run uses its attached service account. Never place credentials in VITE_* variables.
